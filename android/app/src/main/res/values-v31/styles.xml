<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use Theme.SplashScreen for Android 12+ API 31+ -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <!-- Match app background exactly -->
        <item name="windowSplashScreenBackground">#0D0D0D</item>

        <!-- Show the centered branding instantly -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_branding</item>

        <!-- Post-splash theme (the normal theme for your app) -->
        <item name="postSplashScreenTheme">@style/NormalTheme</item>

        <!-- Explicitly set animation duration to 0 -->
        <item name="android:windowSplashScreenAnimationDuration">0</item>

        <!-- Ensure standard fullscreen flags if needed -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
