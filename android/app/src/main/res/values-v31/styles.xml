<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom theme for Android 12+ to match Flutter splash size -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Match app background exactly (Pure Black) -->
        <item name="windowSplashScreenBackground">#000000</item>

        <!-- Use the SCALED icon to avoid the enlarged circular logo -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_scaled</item>

        <!-- Icon background matches the main background for seamless integration -->
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>

        <!-- Theme to switch to after splash is gone -->
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
